# Where updates are published: the ONE place to change it. release-prepare.sh bakes the
# feed URL and public key into the app; publish-appcast.sh uploads the zip to a release on
# NOFI_UPDATES_REPO and pushes appcast.xml to its `appcasts` branch.
#
# Both must be readable WITHOUT credentials: Sparkle never authenticates.
NOFI_UPDATES_REPO=noisyneighborstudio/nofi
NOFI_FEED_URL=https://raw.githubusercontent.com/$NOFI_UPDATES_REPO/appcasts/appcast.xml

# Public half of the EdDSA key in the login-keychain account `whyfi` (the app's former name)
# (generate_keys --account whyfi -p). Its private half is the SPARKLE_PRIVATE_KEY secret.
SPARKLE_PUBLIC_KEY=U1ZihDIaHHV5yD8hnWCuyI4gvey0KUDCe6w+xJq2SAY=
